g-card-icons/calendar.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/listing-card-icons/speedometer.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/listing-card-icons/steering-side.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/listing-card-icons/regional-specs.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/images/map.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/images/phoneOutline.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/images/whatsapp2.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/listing-card-icons/dot-selected.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/listing-card-icons/dot.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/images/chat_icon_colored.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/value-added-service/inspection-banner-tick.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/value-added-service/inspection-banner-location.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/static-resources/assets/value-added-service/inspection-banner-calendar.svg"><link rel="preload" as="image" href="https://static.dubizzle.com/frontend-web/listings/assets/listing-card-icons/tour360icon.svg"><div id="__next"><style>
    #nprogress {
      pointer-events: none;
    }
    #nprogress .bar {
      background: #E00000;
      position: fixed;
      z-index: 9999;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
    }
    #nprogress .peg {
      display: block;
      position: absolute;
      right: 0px;
      width: 100px;
      height: 100%;
      box-shadow: 0 0 10px #E00000, 0 0 5px #E00000;
      opacity: 1;
      -webkit-transform: rotate(3deg) translate(0px, -4px);
      -ms-transform: rotate(3deg) translate(0px, -4px);
      transform: rotate(3deg) translate(0px, -4px);
    }
    #nprogress .spinner {
      display: block;
      position: fixed;
      z-index: 1031;
      top: 15px;
      right: 15px;
    }
    #nprogress .spinner-icon {
      width: 18px;
      height: 18px;
      box-sizing: border-box;
      border: solid 2px transparent;
      border-top-color: #E00000;
      border-left-color: #E00000;
      border-radius: 50%;
      -webkit-animation: nprogresss-spinner 400ms linear infinite;
      animation: nprogress-spinner 400ms linear infinite;
    }
    .nprogress-custom-parent {
      overflow: hidden;
      position: relative;
    }
    .nprogress-custom-parent #nprogress .spinner,
    .nprogress-custom-parent #nprogress .bar {
      position: absolute;
    }
    @-webkit-keyframes nprogress-spinner {
      0% {
        -webkit-transform: rotate(0deg);
      }
      100% {
        -webkit-transform: rotate(360deg);
      }
    }
    @keyframes nprogress-spinner {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }
