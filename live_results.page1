&lt;script type=&quot;text/javascript&quot;&gt;
    var NativeTemplate = function () {
        //returns dom elements
        var createElement = function (a, d, b) {
            if (&quot;object&quot; === typeof a &amp;&amp; a.hasOwnProperty(&quot;elem&quot;)) {
                b = document.createElement(a.elem); &quot;a&quot; === a.elem &amp;&amp; b.setAttribute(&quot;target&quot;, &quot;_blank&quot;); d = Object.keys(a).filter(function (a) { return &quot;elem&quot; != a }); for (var e = 0; e &lt; d.length; e++)switch (d[e]) {
                    case &quot;str&quot;: case &quot;string&quot;: case &quot;innerHTML&quot;: b.innerHTML = a[d[e]]; break; case &quot;innerText&quot;: b.innerText = a[d[e]]; break; case &quot;children&quot;: for (var c = 0; c &lt; a.children.length; c++)a.children[c].nodeType ? b.appendChild(a.children[c]) : b.appendChild(createElement(a.children[c])); break;
                    case &quot;htmlAttribute&quot;: for (c = 0; c &lt; a.htmlAttribute.length; c++)b.setAttribute(a.htmlAttribute[c][0], a.htmlAttribute[c][1]); break; case &quot;listener&quot;: for (c = 0; c &lt; a.listener.length; c++)b.addEventListener(a.listener[c][0], a.listener[c][1], !1); break; default: b.setAttribute(d[e], a[d[e]])
                }
            } else b = document.createElement(&quot;div&quot;); return b
        };


        /**
         * replaces all macros in the variable strings with macro value from GAM || creative-defined default value
         * macro = @@macroName|optionalDefaultValue@@
         * example: Find the best deal for auto insurance on your new @@make|car, truck, or SUV@@ 
         **/
        var findAndReplaceMacros = function (variables, macros) {
            var macroRegex = /@@[a-zA-Z0-9_ ]+(\|{0,1}).+@@/g;  //@@make|car, truck, or SUV@@
            Object.keys(variables).forEach(function (prop) {
                var placeholdersInString = variables[prop].match(macroRegex);
                if (placeholdersInString === null || placeholdersInString.length == 0) {
                    return;
                }
                placeholdersInString.forEach(function (placeholder) {
                    var arr = placeholder.substring(2, placeholder.length - 2).split('|');
                    var macroName = arr[0];
                    var defaultText = arr[1] === undefined ? '' : arr[1];
                    if (macroName === undefined) {
                        console.error('macroName undefined:', placeholder);
                        return;
                    }
                    return variables[prop] = variables[prop].replace(placeholder, (macros.hasOwnProperty(macroName) ? macros[macroName] : defaultText));
                });

            });
            return variables;
        };

        /* interpolate template literals */
        var interpolate = function (domSelectors, variables) {
            domSelectors.forEach(function (selector) {
                var element = document.querySelector(selector);
                if (!element) { return; }
                var template = element.innerHTML;
                Object.keys(variables).forEach(function (key) {
                    template = template.replace(new RegExp('{{' + key + '}}', 'g'), variables[key]);
                });
                element.innerHTML = template;
            });
        }

        if ((&quot;&quot;).indexOf(&quot;http&quot;) === 0) {
            var scriptElement = document.createElement(&quot;script&quot;);
            scriptElement.type = &quot;text/javascript&quot;;
            scriptElement.src = &quot;&quot;;
            document.body.appendChild(scriptElement);
        };

        var impressionTracker = function () {
            if (impressionTracked === true) {
                //console.log('already fired');
                return;
            }
            var trackingPixels = ['', ''].filter(function (p) {
                return p.length &gt; 0 &amp;&amp; p.indexOf('http') === 0;
            });
            if (!trackingPixels.length) {
                //console.log('no tracking pixel fired', trackingPixels);
                return;
            }

            trackingPixels.forEach(function (src) {
                //console.log('tracking pixel fired', src);
                return document.body.appendChild(createElement({
                    elem: 'iframe',
                    class: 'tracking-pixel',
                    frameBorder: '0',
                    src: src,
                    height: '1',
                    width: '1',
                    style: 'width:1px !important; height: 1px !important'
                }));
            });
            impressionTracked = true;
            return;
        };

        var impressionTracked = false;
        var elementsToInterpolate = ['.title', '.subtitle', '.button'];
        //these come from the GAM creative
        var variables = {
            title: `DAMAC District`,
            desc: `Located in DAMAC Hills`,
            cta: `Enquire Now`
        };
        //this is a map of all the key-values passed to GAM
        var macros = '{&quot;breakpoint&quot;:[&quot;1200&quot;],&quot;cl_listing&quot;:[&quot;MTAU&quot;],&quot;cl_subcat&quot;:[&quot;140&quot;],&quot;debug&quot;:[&quot;false&quot;],&quot;language&quot;:[&quot;en&quot;],&quot;page&quot;:[&quot;1&quot;],&quot;page_variant&quot;:[&quot;lpv_2022&quot;],&quot;pos&quot;:[&quot;top&quot;],&quot;site&quot;:[&quot;uae&quot;]}';
        macros = (macros.length &amp;&amp; macros.charAt(0) === '{') ? JSON.parse(macros) : {};

        return {
            init: function () {
                //update the macros in the variable strings
                variables = findAndReplaceMacros(variables, macros);

                //update the dom
                interpolate(elementsToInterpolate, variables);

                //fire tracking pixels if exist
                impressionTracker();
            },
            getVariables: function () {
                return variables;
            },
            getMacros: function () {
                return macros;
            }
        };
    };


    var creative = NativeTemplate();
    creative.init();

    function interpolateClickThru() {
        var ad_unit = '/1000931/dubizzle_desktop/motors_lpv_top/used-cars';
        var url = 'https://adclick.g.doubleclick.net/pcs/click?xai=AKAOjssP60Fez2HwdFWZGJ9TmYGdW6NKVFWsN7LoW2K_KwH2-hYA-AC5gb2lL7H1wTRuOGpGii-z_FmPPpT9Q5ztsnC-xhWW0AiRgrWoFxrGCCprccAOkiCN1NB0a2jghXZkAE3fMq53v3aeMaekhTt_oSabGdHql2kdYQoqEdBbQX9WS2iYzSzZ8yXR8CBxB-gkeEdINzJoMkKsa5ocB6oLIgNy7qjR6Wo4FpZvoTuFMRnRkQ-kAegKdNxF55kJQ9DQilPwJqZLhAcs6uVoHIeT8KK74NX5nahdOb1r60dfKXoOWX2Qy4pGwo8bo9XRrj6fo8X9iXqiGy74bN77xyruimMS33v1Vm78Ye01jQQSPmq1jfWHCrTcXBwNl1H9uv48fBYTa4PQQJ6xwZBz3PEfKWQBgk6c8DzIFdj6ov7rMx7mqPVtjyY&amp;sai=AMfl-YTZixqaAddfqmxTaal9ghDRyzep-WRy7edl3RKplMJGeg8K8zt12mJ7pY5aZHZ6LlbWTrIr9K3P-MPxI0yUitgK0g_XnX9MiiQpuukTDL3qoE_Gm1VVP09e7ANivvgFyNsvH7QEvF_yyAV1DzjW9lAB70cWLM3g__FqXAE_k2GlWBZ1xwiBCXHic7P6EBM8I1ius8f9eaEkQU7yqyCZ58SpFGknvXEtff3geJZ_hf1MLnEynJb0YboggKKmMX_rBlMN6RY-QLZgJKHTS9j0Ia61qkkBPqmnoMJYcSxzH3uz8Lt7on5K9cR--YxWYzx9ZGB_qnoTCgQtqabE5CmBXe8h8KLb-_1Y6S1XqLkv8scv9MoaqOuQwrQ&amp;sig=Cg0ArKJSzDYzx2lxeBIHEAE&amp;fbs_aeid=%5Bgw_fbsaeid%5D&amp;urlfix=1&amp;adurl=https://campaigns.dubizzle.com/uae/damac/district/%3Futm_source%3D4161433340%26utm_medium%3D7400296936%26utm_campaign%3D138529313913%26utm_term%3D/1000931/dubizzle_desktop/motors_lpv_top/used-cars%26utm_content%3Den';
        var replaceURL = false;

        if (url.includes('campaigns.bayut.com') &amp;&amp; ad_unit.includes('dubizzle_')) {
            url = url.replace('campaigns.bayut.com', 'campaigns.dubizzle.com');
            replaceURL = true;
        } else
            if (url.includes('campaigns.dubizzle.com') &amp;&amp; ad_unit.includes('bayut_')) {
                url = url.replace('campaigns.dubizzle.com', 'campaigns.bayut.com');
                replaceURL = true;
            }
        if (replaceURL) {
            var links = document.querySelectorAll('a');
            links.forEach(function (link) {
                link.href = url;
            })
        }

    };
    interpolateClickThru();

&lt;/script&gt;

