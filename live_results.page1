            url('https://static.dubizzle.com/frontend-web/static-resources/assets/fonts/GE%20SS%20Two%20Light.WOFF') format('woff');
        font-display: swap;
    }

    @font-face {
        font-family: GESS;
        font-weight: 600;
        font-style: normal;
        font-variant: normal;
        src: local('GESS'),
            url('https://static.dubizzle.com/frontend-web/static-resources/assets/fonts/GE%20SS%20Two%20Medium.WOFF') format('woff');
        font-display: swap;
    }

    a {
        text-decoration: none;
    }

    body {
        width: 100%;
        padding-bottom: 24px;
        /*border-bottom: 1px solid rgb(224, 225, 227);*/
        /* width: calc(100% - 9px); */
        margin-left: auto;
    }

    .containing_box {
        font-family: 'Proxima-Nova';
        text-decoration: none;
        color: #2b2d2e;
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-content: flex-start;
        align-items: stretch;
    }

    .containing_box .text-container,
    .containing_box .image-container .containing_box .text-container {
        position: relative;
    }

    .containing_box .text-container {
        margin-left: 16px;
        flex-grow: 2;
        width: 50%;
    }

    .image img {
        width: 340px;
        border-radius: 12px 0 0 12px;
        min-height: 225px;
        object-fit: cover;
    }

    .title {
        font-size: 20px;
        font-style: normal;
        font-weight: 600;
        line-height: 24px;
        text-align: start;
        color: #23262A;
        text-decoration: none;
        max-width: 410px;
        text-overflow: ellipsis;
    }

    .desc {
        margin-top: 8px;
        min-height: 110px;
        width: 100%;
        max-width: 410px;
        text-overflow: ellipsis;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 130%;
        color: #23262A;
    }

    .button {
        border: 1px solid #E00000;
        border-radius: 7px;
        background: #E00000;
        text-decoration: none;
        width: 141px;
        height: 42px;
        position: absolute;
        bottom: 6px;
        padding: 0px;
        color: #FFF;
        text-align: center;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 40px;
        transition: .6s ease-in-out;
    }

    .button:hover {
        background: transparent;
        color: #E00000;
    }

    .disclaimer {
        position: absolute;
        top: -20px;
        right: 0px;
        padding: 5px 6px;
        border-radius: 4px;
        text-align: center;
        color: #B6B8B9;
        font-size: 12px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
    }

    .logo {
        position: absolute;
        right: 0px;
        bottom: 0;
        border-radius: 5px;
        border: 1px solid rgb(224, 225, 227);
    }

    .logo img {
        padding: 4px 4px 4px 4px;
        width: 62px;
        height: 62px;
        object-fit: contain;
        vertical-align: middle;
    }

    .tracking-pixel {
        position: absolute;
        bottom: -2px;
        left: -2px;
        border: 0;
    }

    .subtitle {
        font-size: 16px;
        font-weight: 600;
        /* white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 35ch; */
    }

    .desc {
        width: 100%;
    }

    .desc ul li {
        margin: 0 0 3px;
        font-size: 16px;
        font-weight: 400;

    }

    .desc ul li:empty::marker {
        content: &quot;&quot;;
    }

    .desc ul li:empty {
        display: none;
    }

    .title,
    .desc {
        padding-bottom: 6px;
    }

    /* ARABIC SPECIFIC STYLING */
    /* modifies the base style template */
    .ar.wrap .containing_box .text-container,
    .ar .disclaimer,
    .ar .title,
    .ar .desc,
    .ar.logo,
    .ar .button {
        font-family: 'Tajawal', sans-serif;
    }

    .ar.wrap {
        direction: rtl;
        margin-left: auto;
    }

    .ar.wrap .containing_box .text-container {
        margin-left: unset;
        margin-right: 16px;
    }

    .ar.wrap .logo {
        right: unset;
        left: 0px;
    }

    .ar.wrap .containing_box .button {
        text-align: center;
    }

    .ar .title {
        max-width: 300px;
    }

    .ar .disclaimer {
        right: unset;
        left: 0px;
    }
&lt;/style&gt;
